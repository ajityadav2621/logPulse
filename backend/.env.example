ANOMALY_INTERVAL_SECONDS=120

# Bootstrap admin (created on first run if no users exist).
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@logpulse.io
SEED_ADMIN_PASSWORD=changeme123

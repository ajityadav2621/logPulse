# Copy to .env in this same folder and fill in real values before deploying.
# Never commit the real .env.

# --- Postgres (users, roles, audit log) ---
POSTGRES_USER=logpulse
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=logpulse

# --- Mongo (raw log documents) ---
MONGO_DB=logpulse

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/auth/github/callback

# Bootstrap admin created on first run if no users exist yet.
# These can be anything — use a real person's email/username here and have
# them change the password after first login (or via forgot-password).
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@logpulse.io
SEED_ADMIN_PASSWORD=changeme123

# --- Email / SMTP (password resets, invites) ---
# Gmail App Password: enable 2FA on the account, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (never the account password). The defaults below match
# logpulse.notification@gmail.com via smtp.gmail.com:587 (STARTTLS).
# Port 465 switches to implicit TLS. Any provider (SES, Resend, Mailgun)
# that speaks SMTP works — just change host/port/credentials.
# Leave SMTP_USERNAME/SMTP_PASSWORD empty to disable sending: emails are
# then logged to the backend output instead of delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=logpulse.notification@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=LogPulse
EMAIL_FROM_ADDRESS=logpulse.notification@gmail.com

# --- Advanced monitoring ---
# Posts fired alerts to any JSON endpoint (Slack/Discord/n8n). Leave empty to disable.
ALERT_WEBHOOK_URL=
# Pause between background anomaly sweeps, in seconds.
ANOMALY_INTERVAL_SECONDS=120

# --- Frontend build ---
# Where the BROWSER reaches the backend. Leave as-is for local docker compose
# (backend published on 8080). For a real domain, point this at your public
# API URL/subdomain instead and rebuild the frontend image.
VITE_API_URL=http://localhost:8080

# --- Docs (Docusaurus static build) ---
VITE_DOCS_URL=http://localhost:3001
DOCS_HOST_PORT=3001

# --- Host port mappings (change if these collide with something else) ---
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
